# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Pipeline intermediates: raw/cleaned POIs and the LLM copy cache.
# These are regenerated by the scripts and must not be committed
# (raw_poi.json may contain mock data that must never ship).
pipeline/data/
__pycache__/
*.pyc

# Python virtualenvs & local env files (weather/AMap keys live here, never commit).
.venv/
venv/
.env
.env.*

# Design-source material, not referenced by the app. The code only uses
# src/assets/gacha/**; these are the raw drops / zips / extraction folders and
# would bloat the repo (tens of MB) for no runtime benefit.
*.zip
lucky-gacha-assets/
lucky-gacha-extracted/
src/assets/lucky-gacha/

# Stray scratch files.
untitled
untitled1
